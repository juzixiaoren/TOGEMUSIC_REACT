SOCKET_PATH=/socket.io
SOCKETIO_ASYNC_MODE=threading
SOCKETIO_PING_INTERVAL=10
SOCKETIO_PING_TIMEOUT=15
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8034
QQMUSIC_COOKIE=YOUR_QQMUSIC_COOKIE

# ========== 存储后端配置 ==========
# cos = 腾讯云COS（默认），local = 本地文件
STORAGE_BACKEND=cos

# ========== 腾讯云 COS 配置 ==========
COS_SECRET_ID=YOUR_COS_SECRET_ID
COS_SECRET_KEY=YOUR_COS_SECRET_KEY
COS_BUCKET=YOUR_COS_BUCKET
COS_REGION=YOUR_COS_REGION
# 预签名URL有效期（秒）
COS_PRESIGN_EXPIRE=3600